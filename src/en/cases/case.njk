---
pagination:
  data: cases
  size: 1
  alias: item
permalink: "en/{{ item.slug }}.html"
layout: layouts/base.njk
lang: en
navActive: cases
isHome: false
ogType: article
eleventyComputed:
  slug: "{{ item.slug }}"
  metaTitle: "{{ item.en.metaTitle }}"
  metaDescription: "{{ item.en.metaDescription }}"
  ogImage: "{{ item.heroMedia.src }}"
---
{% from "partials/media-row.njk" import mediaRow %}
{% from "partials/portfolio-card.njk" import card %}
{% set caseSchema = { "@context": "https://schema.org", "@type": "CreativeWork", "name": item.en.heroTitleLine1 + " " + item.en.heroTitleLine2, "description": item.en.metaDescription, "image": site.baseUrl + item.heroMedia.src, "url": site.baseUrl + "/en/" + item.slug, "creator": { "@type": "Organization", "name": "Melo Creative", "url": site.baseUrl + "/" }, "about": item.en.tags, "dateCreated": item.year, "inLanguage": "en" } %}
<script type="application/ld+json">
{{ caseSchema | dump | safe }}
</script>
  <section class="case-hero-header reveal">
    <div>
      <h1>{{ item.en.heroTitleLine1 }}<br />{{ item.en.heroTitleLine2 }}</h1>
    </div>
    <div class="case-tags">
      {% for tag in item.en.tags %}<span class="case-tag">{{ tag }}</span>
      {% endfor %}
    </div>
  </section>

  <div class="case-media-row single">
    <div class="case-media{{ ' contain' if item.heroMedia.fit == 'contain' }}{{ ' ' + item.heroMedia.filter if item.heroMedia.filter }}">
      <img src="{{ item.heroMedia.src }}" alt="{{ item.en.heroAlt }}" loading="lazy" />
    </div>
  </div>

  <section class="section-about">
    <div class="case-text-row reveal">
      <div class="tag">
        <span class="tag-text">{{ item.en.challengeTag }}</span>
        <img class="tag-dot" src="/assets/icons/ellipse-tag.svg" alt="" />
      </div>
      <div class="case-text-content">
        <p class="case-text-heading">{{ item.en.challengeHeading }}</p>
        <p class="case-text-detail">{{ item.en.challengeDetail }}</p>
      </div>
    </div>
  </section>

  {% for row in item.rowsBeforeApproach %}{{ mediaRow(row) }}{% endfor %}

  <section class="section-about">
    <div class="case-text-row reveal">
      <div class="tag">
        <span class="tag-text">{{ item.en.approachTag }}</span>
        <img class="tag-dot" src="/assets/icons/ellipse-tag.svg" alt="" />
      </div>
      <div class="case-text-content">
        <p class="case-text-heading">{{ item.en.approachHeading }}</p>
        <p class="case-text-detail">{{ item.en.approachDetail }}</p>
      </div>
    </div>
  </section>

  {% for row in item.rowsAfterApproach %}{{ mediaRow(row) }}{% endfor %}

  <!-- OTHER CASES -->
  <section class="section-portfolio-intro">
    <div class="portfolio-intro-row reveal">
      <h2>{{ i18n.en.moreCases }}</h2>
      <a class="btn btn-dark" href="/en/cases">
        {{ i18n.en.allCases }}
        <img class="btn-icon" src="/assets/icons/arrow-right.svg" alt="" />
      </a>
    </div>
  </section>

  <div class="portfolio-grid reveal-stagger">
    {% for otherSlug in item.otherCases %}{{ card(cases | findCase(otherSlug), "en", "/en", false) }}{% endfor %}
  </div>

  <!-- FAQ -->
  {% set faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": pages.home.en.faq | faqEntities } %}
  <script type="application/ld+json">
  {{ faqSchema | dump | safe }}
  </script>
  <section class="section-about section-faq">
    <div class="faq-row">
      <div class="faq-intro reveal">
        <div class="tag">
          <span class="tag-text">{{ pages.home.en.faqTag }}</span>
          <img class="tag-dot" src="/assets/icons/ellipse-tag.svg" alt="" />
        </div>
        <h2>{{ pages.home.en.faqHeading }}</h2>
        <a class="btn btn-orange" href="{{ site.quoteForm }}" target="_blank" rel="noopener noreferrer">
          {{ i18n.en.ctaQuote }}
          <img class="btn-icon" src="/assets/icons/arrow-right.svg" alt="" />
        </a>
      </div>
      <div class="faq-list reveal-stagger">
        {% for faqItem in pages.home.en.faq %}
        <details class="faq-item">
          <summary>{{ faqItem.q }}</summary>
          <p>{{ faqItem.a }}</p>
        </details>
        {% endfor %}
      </div>
    </div>
  </section>
