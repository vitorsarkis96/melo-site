---
permalink: "sobre.html"
layout: layouts/base.njk
lang: en
slug: sobre
navActive: about
isHome: false
ogType: website
eleventyComputed:
  metaTitle: "{{ pages.sobre.en.metaTitle }}"
  metaDescription: "{{ pages.sobre.en.metaDescription }}"
  ogImage: "{{ pages.sobre.ogImage }}"
---
{% set s = pages.sobre.en %}
  <section class="case-hero-header reveal">
    <div>
      <h1>{{ s.heroLine1 }}<br />{{ s.heroLine2 }}</h1>
    </div>
  </section>

  <!-- THE PROBLEM -->
  <section class="section-about">
    <div class="intro-row reveal">
      <div class="tag">
        <span class="tag-text">{{ s.whyMeloTag }}</span>
        <img class="tag-dot" src="/assets/icons/ellipse-tag.svg" alt="" />
      </div>
      <div class="about-melo-text" style="max-width: 620px;">
        <p class="intro-statement" style="margin-bottom: 16px;">{{ s.introStatement }}</p>
        <p>{{ s.introBody }}</p>
      </div>
    </div>
  </section>

  <!-- NUMBERS -->
  <section class="section-numbers">
    <div class="numbers-inner">
      <div class="tag reveal">
        <span class="tag-text">{{ s.numbersTag }}</span>
        <img class="tag-dot" src="/assets/icons/ellipse-tag.svg" alt="" />
      </div>

      <div class="numbers-headline-row reveal">
        <div class="big-number">
          <p class="big-number__value"><span class="plus">+</span><span class="count-up" data-target="{{ s.bigNumberValue }}">{{ s.bigNumberValue }}</span></p>
          <p class="big-number__label">{{ s.bigNumberLabel }}</p>
        </div>
        <p class="numbers-desc">{{ s.numbersDesc }}</p>
      </div>

      <div class="numbers-divider"></div>

      <div class="stats-row reveal-stagger">
        {% for stat in s.stats %}
        <div class="stat">
          <div>
            <p class="stat__value{{ ' orange-value' if stat.orange }}"><span class="accent">+</span><span class="count-up" data-target="{{ stat.value }}"{% if stat.format %} data-format="{{ stat.format }}"{% endif %}>{{ stat.value | formatNumber(stat.format) }}</span>{{ stat.suffix }}</p>
            <p class="stat__label">{{ stat.label }}</p>
          </div>
          <p class="stat__desc">{{ stat.desc }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <!-- UNIFIED ECOSYSTEM -->
  <section class="section-about">
    <div class="intro-row reveal">
      <div class="tag">
        <span class="tag-text">{{ s.ecosystemTag }}</span>
        <img class="tag-dot" src="/assets/icons/ellipse-tag.svg" alt="" />
      </div>
      <p class="intro-statement">{{ s.ecosystemStatement }}</p>
    </div>
  </section>

  <!-- WHAT WE DO -->
  <section class="section-about">
    <div class="services reveal-stagger">
      {% for service in s.services %}
      <div class="service-row">
        {% if loop.first %}
        <div class="tag">
          <span class="tag-text">{{ s.whatWeDoTag }}</span>
          <img class="tag-dot" src="/assets/icons/ellipse-tag.svg" alt="" />
        </div>
        {% else %}
        <div class="tag" style="visibility:hidden"><span class="tag-text">&nbsp;</span></div>
        {% endif %}
        <div class="service-content">
          <h2 class="service-title">{{ service.title }}</h2>
          <div class="service-aside">
            <p class="service-desc">{{ service.desc }}</p>
            <a class="btn btn-orange service-row__cta" href="{{ site.quoteForm }}" target="_blank" rel="noopener noreferrer">
            {{ i18n.en.ctaQuote }}
            <img class="btn-icon" src="/assets/icons/arrow-right.svg" alt="" />
          </a>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
  </section>

  <!-- HOW WE OPERATE -->
  <section class="section-about">
    <div class="intro-row reveal">
      <div class="tag">
        <span class="tag-text">{{ s.howTag }}</span>
        <img class="tag-dot" src="/assets/icons/ellipse-tag.svg" alt="" />
      </div>
      <div class="about-melo-text" style="max-width: 620px;">
        <p class="intro-statement" style="margin-bottom: 16px;">{{ s.howStatement }}</p>
        <p>{{ s.howBody }}</p>
      </div>
    </div>
  </section>
