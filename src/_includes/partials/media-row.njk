{% macro mediaItem(item) %}
{%- set ytId = (item.src | youtubeId) if item.type == "video" else null -%}
{%- if item.type == "video" and ytId -%}
    <iframe src="https://www.youtube.com/embed/{{ ytId }}?autoplay=1&mute=1&loop=1&playlist={{ ytId }}&controls=0&playsinline=1&modestbranding=1&rel=0" title="" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen loading="lazy"></iframe>
{%- elif item.type == "video" -%}
    <video autoplay muted loop playsinline{% if item.poster %} poster="{{ item.poster }}"{% endif %}>
      <source src="{{ item.src }}" type="{{ item.src | videoType }}" />
    </video>
{%- else -%}
    <img src="{{ item.src }}" alt="{{ item.alt or '' }}" loading="lazy" />
{%- endif -%}
{% endmacro %}

{% macro mediaRow(row) %}
  <div class="case-media-row{{ ' single' if row.layout == 'single' }}">
    {% for item in row.items %}
    <div class="case-media{{ ' contain' if item.fit == 'contain' }}"{% if item.bg %} style="background:{{ item.bg }}"{% endif %}>
      {{ mediaItem(item) }}
    </div>
    {% endfor %}
  </div>
{% endmacro %}
