{% macro mediaItem(item) %}
{%- set ytId = (item.src | youtubeId) if item.type == "video" else null -%}
{%- if item.type == "video" and ytId -%}
    <iframe src="https://www.youtube.com/embed/{{ ytId }}?loop=1&playlist={{ ytId }}&controls=1&playsinline=1&modestbranding=1&rel=0" title="" frameborder="0" allow="autoplay; encrypted-media; fullscreen" allowfullscreen loading="lazy"></iframe>
{%- elif item.type == "video" -%}
    <video controls loop playsinline{% if item.poster %} poster="{{ item.poster }}"{% endif %}>
      <source src="{{ item.src }}" type="{{ item.src | videoType }}" />
    </video>
{%- elif item.type == "spec-cards" -%}
    <div class="case-spec-cards{{ ' case-spec-cards--top' if item.variant == 'top' }}">
      {% for p in item.products %}
      {% if item.variant == "top" %}
      <div class="case-spec-card case-spec-card--top">
        <span class="case-spec-badge">{{ p.badge }}</span>
        <div class="case-spec-card__photo"><img src="{{ p.image }}" alt="{{ p.title }}" loading="lazy" /></div>
        <div class="case-spec-card__body">
          <div class="case-spec-card__text">
            <p class="case-spec-card__title">{{ p.title }}</p>
            <p class="case-spec-card__subtitle">{{ p.subtitle }}</p>
          </div>
          <hr class="case-spec-card__divider" />
          <p class="case-spec-card__desc">{{ p.desc }}</p>
        </div>
      </div>
      {% else %}
      <div class="case-spec-card">
        <div class="case-spec-card__body">
          <span class="case-spec-badge">{{ p.badge }}</span>
          <div class="case-spec-card__text">
            <p class="case-spec-card__title">{{ p.title }}</p>
            <p class="case-spec-card__subtitle">{{ p.subtitle }}</p>
          </div>
          <hr class="case-spec-card__divider" />
          <p class="case-spec-card__desc">{{ p.desc }}</p>
        </div>
        <div class="case-spec-card__photo"><img src="{{ p.image }}" alt="{{ p.title }}" loading="lazy" /></div>
      </div>
      {% endif %}
      {% endfor %}
    </div>
{%- elif item.type == "swatches" -%}
    <div class="case-swatches">
      {% for bar in item.bars %}
      {% if bar.colors %}
      <div class="case-swatches__row" style="flex:{{ bar.weight }}">
        {% for c in bar.colors %}<div class="case-swatches__cell" style="background:{{ c }}"></div>{% endfor %}
      </div>
      {% else %}
      <div class="case-swatches__cell" style="flex:{{ bar.weight }};background:{{ bar.color }}"></div>
      {% endif %}
      {% endfor %}
    </div>
{%- elif item.type == "pattern" -%}
    {% if item.logo %}<img class="case-pattern__logo" src="{{ item.logo }}" alt="" loading="lazy" />{% endif %}
{%- elif item.type == "spotlight" -%}
    <div class="case-spotlight__overlay"></div>
    {% if item.logo %}<img class="case-spotlight__logo" src="{{ item.logo }}" alt="" loading="lazy" />{% endif %}
    <div class="case-spotlight__content">
      <p class="case-spotlight__heading">{{ item.heading | safe }}</p>
      <p class="case-spotlight__desc">{{ item.desc }}</p>
    </div>
    {% if item.awards %}
    <div class="case-spotlight__awards">
      {% for award in item.awards %}<img src="{{ award }}" alt="" loading="lazy" />{% endfor %}
    </div>
    {% endif %}
    {% if item.badgeText %}<span class="case-spotlight__badge">{{ item.badgeText }}</span>{% endif %}
{%- else -%}
{% if item.floating %}
    <div class="case-media__floating-card"><img src="{{ item.src }}" alt="{{ item.alt or '' }}" loading="lazy" /></div>
{% else %}
    <img src="{{ item.src }}" alt="{{ item.alt or '' }}" loading="lazy"{% if item.position %} style="object-position:{{ item.position }}"{% endif %} />
{% endif %}
{%- endif -%}
{% endmacro %}

{% macro mediaRow(row) %}
  {% if row.layout == "carousel" %}
  <div class="case-carousel" data-carousel>
    <div class="case-carousel__tabs" role="tablist" data-carousel-tabs>
      {% for item in row.items %}
      <button type="button" class="case-carousel__tab{{ ' is-active' if item.default }}" data-carousel-tab="{{ loop.index0 }}">{{ item.label or item.heading }}</button>
      {% endfor %}
    </div>
    <div class="case-media-row carousel" data-carousel-track>
      {% for item in row.items %}
      <div class="case-media case-spotlight"{% if item.default %} data-carousel-default{% endif %} data-carousel-item style="background-image:url('{{ item.bg }}')">
        {{ mediaItem(item) }}
      </div>
      {% endfor %}
    </div>
  </div>
  {% else %}
  <div class="case-media-row{{ ' single' if row.layout == 'single' }}">
    {% for item in row.items %}
    {% if item.type == "spec-cards" %}
    <div class="case-media case-media--specs">
      {{ mediaItem(item) }}
    </div>
    {% elif item.type == "spotlight" %}
    <div class="case-media case-spotlight" style="background-image:url('{{ item.bg }}')">
      {{ mediaItem(item) }}
    </div>
    {% elif item.type == "swatches" %}
    <div class="case-media case-media--swatches">
      {{ mediaItem(item) }}
    </div>
    {% elif item.type == "pattern" %}
    <div class="case-media case-pattern" style="background-color:{{ item.bg }}">
      {{ mediaItem(item) }}
    </div>
    {% else %}
    <div class="case-media{{ ' contain' if item.fit == 'contain' }}{{ ' floating' if item.floating }}{{ ' ' + item.filter if item.filter }}"{% if item.bg %} style="background:{{ item.bg }}"{% endif %}>
      {{ mediaItem(item) }}
    </div>
    {% endif %}
    {% endfor %}
  </div>
  {% endif %}
{% endmacro %}
