{% macro card(caseItem, lang, prefix, withFilter) %}
{%- set locale = caseItem[lang] -%}
    <a class="portfolio-card"{% if withFilter %} data-service="{{ caseItem.dataService | join(' ') }}"{% endif %} href="{{ (prefix + '/' + caseItem.slug) | replace('//','/') }}">
      <img class="card-bg" src="{{ caseItem.cardImage }}" alt="{{ locale.cardTitle }}" loading="lazy" />
      <div class="portfolio-card__content">
        <div class="project-label">
          <p class="title">{{ locale.cardTitle }}</p>
          <p class="desc">{{ locale.cardDesc }}</p>
        </div>
      </div>
    </a>
{% endmacro %}
