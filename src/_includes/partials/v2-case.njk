{%- from "partials/v2-media.njk" import row -%}
{%- set t = i18n[lang] -%}
{%- set c = v2[lang] -%}
{%- set P = t.prefix -%}
{%- set d = item[lang] -%}
{%- set AR = '<svg class="ar" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M1 6h10M7 2l4 4-4 4"/></svg>' -%}
{%- set name = d.heroTitleLine1 -%}
{%- set project = d.heroTitleLine2 | trim -%}

<section class="hero case-hero">
  <div class="stage"><img class="on" data-img="case:{{ item.slug }}|heroMedia.src" src="{{ item.heroMedia.src }}" alt="{{ d.heroAlt or name }}" fetchpriority="high"{% if item.heroMedia.position or item.cardImagePosition %} style="object-position:{{ item.heroMedia.position or item.cardImagePosition }}"{% endif %}></div>
  <div class="hero-in">
    <div class="wrap hero-row">
      <div class="hero-txt">
        <span class="crumb fade"><a href="{{ (P + '/cases') | replace('//','/') }}">{{ c.nav.cases }}</a><span>/</span>{{ name }}</span>
        <h1 class="h1 fade d1"><span data-e="case:{{ item.slug }}|{{ lang }}.heroTitleLine1">{{ name }}</span><span class="pt">.</span></h1>
        <p class="lead fade d2"><span data-e="case:{{ item.slug }}|{{ lang }}.heroTitleLine2">{{ project }}</span></p>
      </div>
    </div>
  </div>
</section>

<div class="wrap">
  <div class="ficha rv">
    <div><span class="mono">{{ c.casePage.client }}</span>{{ name }}</div>
    <div><span class="mono">{{ c.casePage.project }}</span>{{ project }}</div>
    <div><span class="mono">{{ c.casePage.fronts }}</span>{{ d.tags | join(' · ') }}</div>
    <div><span class="mono">{{ c.casePage.year }}</span>{{ item.year }}</div>
  </div>

  <section class="case-txt">
    <span class="kicker rv">{{ c.casePage.challenge }}</span>
    <div class="right"><h2 class="h2 rv d1" data-e="case:{{ item.slug }}|{{ lang }}.challengeHeading">{{ d.challengeHeading }}</h2><div class="rv d2"><p data-e="case:{{ item.slug }}|{{ lang }}.challengeDetail">{{ d.challengeDetail }}</p></div></div>
  </section>

  <div class="gal" data-gal="case:{{ item.slug }}|rowsBeforeApproach">{% for r in item.rowsBeforeApproach %}{{ row(r, name, "case:" + item.slug + "|rowsBeforeApproach." + loop.index0) }}{% endfor %}</div>

  <section class="case-txt">
    <span class="kicker rv">{{ c.casePage.approach }}</span>
    <div class="right"><h2 class="h2 rv d1" data-e="case:{{ item.slug }}|{{ lang }}.approachHeading">{{ d.approachHeading }}</h2><div class="rv d2"><p data-e="case:{{ item.slug }}|{{ lang }}.approachDetail">{{ d.approachDetail }}</p></div></div>
  </section>

  <div class="gal gal-end" data-gal="case:{{ item.slug }}|rowsAfterApproach">{% for r in item.rowsAfterApproach %}{{ row(r, name, "case:" + item.slug + "|rowsAfterApproach." + loop.index0) }}{% endfor %}</div>
</div>

{%- set nx = cases | nextCase(item) -%}
{% if nx %}
<a class="next" href="{{ P }}/{{ nx.slug }}">
  <img src="{{ nx.heroMedia.src }}" alt="" loading="lazy"{% if nx.cardImagePosition %} style="object-position:{{ nx.cardImagePosition }}"{% endif %}>
  <div class="wrap">
    <span class="kicker">{{ c.casePage.next }}</span>
    <span class="h1">{{ nx[lang].heroTitleLine1 }}<span class="pt">.</span></span>
    <span class="sub">{{ nx[lang].heroTitleLine2 | trim }} {{ AR | safe }}</span>
  </div>
</a>
{% endif %}

<section class="cta-band">
  <div class="wrap">
    <h2 class="h2 rv"><span data-e="{{ lang }}|casePage.ctaTitle">{{ c.casePage.ctaTitle }}</span><span class="pt">.</span></h2>
    <div class="hero-ctas rv d1"><a class="btn btn-gray" href="{{ t.contactPath }}">{{ c.nav.cta }} {{ AR | safe }}</a><a class="btn btn-ghost" href="{{ (P + '/cases') | replace('//','/') }}">{{ c.casePage.allCases }}</a></div>
  </div>
</section>
