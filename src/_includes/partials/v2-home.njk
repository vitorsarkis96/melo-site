{%- set t = i18n[lang] -%}
{%- set c = v2[lang] -%}
{%- set P = t.prefix -%}
{%- set AR = '<svg class="ar" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M1 6h10M7 2l4 4-4 4"/></svg>' -%}
{%- set PLAY = '<svg viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M3 1.5v9l7.5-4.5z"/></svg>' -%}
{%- set STARS = '<span class="stars" aria-label="' + c.reviewsSec.stars + '">★★★★★</span>' -%}
{% set orgSchema = { "@context": "https://schema.org", "@type": "Organization", "name": "Melo Creative", "url": site.baseUrl + "/", "logo": site.baseUrl + "/assets/icons/logo-melo.svg", "image": site.baseUrl + "/assets/img/cases/mev-hero-folder.jpg", "description": c.metaDescription, "email": site.email, "telephone": "+5511954387151", "address": { "@type": "PostalAddress", "streetAddress": "Rua Conde do Pinhal 8 - Liberdade", "addressLocality": "São Paulo", "addressRegion": "SP", "addressCountry": "BR" }, "aggregateRating": { "@type": "AggregateRating", "ratingValue": "5.0", "reviewCount": "24" }, "sameAs": [site.instagram, site.linkedin, v2.social.facebook, v2.social.linktree, v2.social.upwork], "knowsAbout": ["Comunicação corporativa", "Autoridade de marca", "Branding e identidade visual", "Cultura e comunicação interna", "Sites institucionais", "Produção audiovisual"] } %}
<script type="application/ld+json">{{ orgSchema | dump | safe }}</script>

<!-- HERO -->
<section class="hero" id="topo">
  <div class="stage" id="figStage">
    {% for s in v2.heroCases %}{% set hc = cases | findCase(s) %}{% if hc %}<img src="{{ hc.heroMedia.src }}" alt="{{ hc[lang].heroTitleLine1 }}"{% if not loop.first %} loading="lazy"{% else %} class="on" fetchpriority="high"{% endif %}{% if hc.heroMedia.position %} style="object-position:{{ hc.heroMedia.position }}"{% endif %}>{% endif %}{% endfor %}
  </div>
  <div class="hero-in">
    <div class="wrap hero-row">
      <div class="hero-txt">
        <h1 class="h1 fade d1">{{ c.hero.l1 }} <span class="l2">{{ c.hero.l2 }}<span class="pt">.</span></span></h1>
        <div class="hero-ctas fade d3">
          <a class="btn btn-gray" href="#contato">{{ c.nav.cta }} {{ AR | safe }}</a>
          <a class="btn btn-ghost" href="#cases">{{ c.hero.cases }}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="meta-band">
  <div class="wrap">
    <div class="hero-meta rv">
      {% for m in c.meta %}<div><span class="mono">{{ m[0] }}</span>{{ m[1] }}</div>{% endfor %}
    </div>
  </div>
</div>

<!-- LOGOS -->
<div class="logos" aria-label="Clientes">
  <div class="logos-mask"><div class="logos-track">
    {% for k in [0, 1] %}{% for cl in v2.clients %}<span class="lg"{% if k %} aria-hidden="true"{% endif %}><img src="/assets/img/clients/{{ cl[0] }}.png" alt="{{ cl[1] if not k else '' }}" loading="lazy"></span>{% endfor %}{% endfor %}
  </div></div>
</div>

<!-- SHOWREEL + O QUE RESOLVEMOS -->
<section class="sec" id="traducao">
  <span id="atuamos"></span>
  <div class="wrap reel-split">
    <button class="reel-thumb rv" type="button" data-reel aria-label="{{ c.reelSec.aria }}">
      <img src="https://i.ytimg.com/vi/{{ v2.reel }}/maxresdefault.jpg" alt="" loading="lazy" onerror="if(!this.dataset.f){this.dataset.f=1;this.src='https://i.ytimg.com/vi/{{ v2.reel }}/hqdefault.jpg'}else{this.remove()}">
      <span class="pl"><i>{{ PLAY | safe }}</i><span>{{ c.reelSec.label }}<small>{{ c.reelSec.watch }}</small></span></span>
    </button>
    <div class="reel-txt">
      <span class="kicker rv"><b>01</b>{{ c.reelSec.kicker }}</span>
      <h2 class="h2 rv d1">{{ c.reelSec.title }}<span class="pt">.</span></h2>
      <p class="lead rv d2">{{ c.reelSec.lead }}</p>
      <div class="rv d3"><a class="btn btn-gray" href="#contato">{{ c.reelSec.cta }} {{ AR | safe }}</a></div>
    </div>
  </div>
</section>

<!-- SERVIÇOS -->
<section class="sec bg-g" id="servicos">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker rv"><b>02</b>{{ c.servicesSec.kicker }}</span>
      <div class="right">
        <h2 class="h2 rv d1">{{ c.servicesSec.title }}<span class="pt">.</span></h2>
        <p class="lead rv d2">{{ c.servicesSec.lead }}</p>
      </div>
    </div>
    <div class="rv">
      <div class="folder-tabs" role="tablist" id="tabs">
        {% for s in c.services %}<button role="tab" aria-selected="{{ 'true' if loop.first else 'false' }}" data-i="{{ loop.index0 }}"{% if loop.first %} class="on"{% endif %}><span class="mono">{{ loop.index | pad2 }}</span>{{ s.tab }}</button>{% endfor %}
      </div>
      {% for s in c.services %}{% set si = v2.serviceImages[s.key] %}
      <div class="folder" role="tabpanel" data-panel="{{ loop.index0 }}"{% if not loop.first %} hidden{% endif %}>
        <div class="doc">
          <div class="doc-top"><span class="kicker"><b>{{ loop.index | pad2 }}</b>{{ s.s }}</span><h3 class="h3">{{ s.t }}<span class="pt">.</span></h3><p>{{ s.d }}</p></div>
          <ul class="deliv">{% for x in s.l %}<li>{{ x }}</li>{% endfor %}</ul>
          <div><a class="btn btn-gray" href="#contato">{{ c.servicesSec.talk }} {{ AR | safe }}</a></div>
        </div>
        <div class="pic">
          <div class="crop"><i></i><i></i><i></i><i></i><span class="reg"></span><img src="{{ si.img }}" alt="{{ si.name }}" loading="lazy"{% if si.pos %} style="object-position:{{ si.pos }}"{% endif %}></div>
          <a class="mono rel" href="{{ P }}/{{ si.slug }}">{{ c.servicesSec.related }} · {{ si.name }} →</a>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- CASES -->
<section class="sec" id="cases">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker rv"><b>03</b>{{ c.casesSec.kicker }}</span>
      <div class="right"><h2 class="h2 rv d1">{{ c.casesSec.title }}<span class="pt">.</span></h2></div>
    </div>
    <div class="idx-list rv" id="idxList">
      {% for s in v2.homeCases %}{% set hc = cases | findCase(s) %}{% if hc %}
      <a class="idx-row" href="{{ P }}/{{ hc.slug }}" data-img="{{ hc.cardImage or hc.heroMedia.src }}"{% if hc.cardImagePosition %} data-pos="{{ hc.cardImagePosition }}"{% endif %}>
        <span class="n">{{ loop.index | pad2 }}</span>
        <span class="thumb"><img src="{{ hc.cardImage or hc.heroMedia.src }}" alt="" loading="lazy"{% if hc.cardImagePosition %} style="object-position:{{ hc.cardImagePosition }}"{% endif %}></span>
        <span class="client">{{ hc[lang].heroTitleLine1 }}</span>
        <span class="proj">{{ hc[lang].heroTitleLine2 | trim }}</span>
        <span class="tags">{{ hc[lang].tags | join(' · ') }}</span>
        <svg class="go" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M1 6h10M7 2l4 4-4 4"/></svg>
      </a>{% endif %}{% endfor %}
    </div>
    <div class="idx-after rv">
      <a class="btn btn-ghost" href="{{ (P + '/cases') | replace('//','/') }}">{{ c.casesSec.all }} {{ AR | safe }}</a>
    </div>
  </div>
  <div class="preview" id="preview" aria-hidden="true"><div class="crop"><i></i><i></i><i></i><i></i><span class="reg"></span><img id="previewImg" alt=""></div></div>
</section>

<!-- MÉTODO -->
<section class="sec bg-dark" id="metodo">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker rv"><b>04</b>{{ c.methodSec.kicker }}</span>
      <div class="right">
        <h2 class="h2 rv d1">{{ c.methodSec.title }}<span class="pt">.</span></h2>
        <p class="lead rv d2">{{ c.methodSec.lead }}</p>
      </div>
    </div>
    <div class="proto rv">
      <div class="proto-head">{% for h in c.methodSec.head %}<span>{{ h }}</span>{% endfor %}</div>
      {% for m in c.method %}<div class="proto-row"><span class="n">{{ loop.index | pad2 }}</span><h3>{{ m[0] }}</h3><p>{{ m[1] }}</p><span class="out">{{ m[2] }}</span></div>{% endfor %}
    </div>
    <p class="cycle rv"><svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M12 7a5 5 0 11-1.5-3.6M12 1.5v2.5H9.5"/></svg>{{ c.methodSec.cycle }}</p>
  </div>
</section>

<!-- NÚMEROS + AVALIAÇÕES -->
<section class="sec bg-g" id="numeros">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker rv"><b>05</b>{{ c.numbersSec.kicker }}</span>
      <div class="right"><h2 class="h2 rv d1">{{ c.numbersSec.title }}<span class="pt">.</span></h2></div>
    </div>
    <div class="nums rv">
      {% for n in c.numbers %}<div class="num"><span class="mono">{{ n[0] }}</span><div class="v">{% if n[1] %}<em>{{ n[1] }}</em>{% endif %}<span class="cnt" data-to="{{ n[2] }}">{{ n[2] | formatNumber('thousand') }}</span>{% if n[3] %}<em>{{ n[3] }}</em>{% endif %}</div><p>{{ n[4] }}</p></div>{% endfor %}
    </div>
    <div class="revs">
      <div class="revs-head rv">
        <div class="score"><b>5,0</b>{{ STARS | safe }}</div>
        <span class="mono">{{ c.reviewsSec.count }}</span>
        <a class="mono link" href="{{ v2.social.maps }}" target="_blank" rel="noopener">{{ c.reviewsSec.all }}</a>
        <div class="rev-nav"><button class="sqb" id="revPrev" aria-label="{{ c.reviewsSec.prev }}"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M11 6H1M5 2L1 6l4 4"/></svg></button><span class="mono" id="revCount"></span><button class="sqb" id="revNext" aria-label="{{ c.reviewsSec.next }}">{{ AR | replace('class="ar" ', '') | safe }}</button></div>
      </div>
      <div class="revs-grid">
        {% for r in c.reviews %}<figure class="rev rv">{{ STARS | safe }}<blockquote>“{{ r[2] }}”</blockquote><figcaption><b>{{ r[0] }}</b><span>{{ r[1] }}</span></figcaption></figure>{% endfor %}
      </div>
    </div>
  </div>
</section>

<!-- FAQ -->
<script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": c.faq | faqPairs } | dump | safe }}</script>
<section class="sec" id="faq">
  <div class="wrap faq">
    <div style="display:grid;gap:var(--stack);align-content:start">
      <span class="kicker rv"><b>06</b>{{ c.faqSec.kicker }}</span>
      <h2 class="h2 rv d1">{{ c.faqSec.title }}<span class="pt">.</span></h2>
      <p class="lead rv d2">{{ c.faqSec.lead }} <a href="mailto:{{ site.email }}" style="border-bottom:1px solid var(--orange)">{{ site.email }}</a>.</p>
    </div>
    <div class="faq-list rv d1">
      {% for f in c.faq %}<details{% if loop.first %} open{% endif %}><summary><span class="mono">{{ loop.index | pad2 }}</span>{{ f[0] }}<span class="pm"></span></summary><p>{{ f[1] }}</p></details>{% endfor %}
    </div>
  </div>
</section>

{% set contactKicker = "07" %}
{% include "partials/v2-contact.njk" %}
