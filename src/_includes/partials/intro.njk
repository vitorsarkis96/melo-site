{#- Vinheta "Prancheta" (só na home). Controle: assets/js/intro.js · estilo: assets/css/intro.css -#}
{%- set introPt = { words: ["Marcas", "Sites", "Filmagens", "Digital", "Impressos"], sheet: "FOLHA 01/01", scale: "ESCALA 1:1", skip: "Pular" } -%}
{%- set introEn = { words: ["Brands", "Websites", "Film", "Digital", "Print"], sheet: "SHEET 01/01", scale: "SCALE 1:1", skip: "Skip" } -%}
{%- set ic = introPt if lang == "pt" else introEn -%}
<div class="bp" id="meloIntro" aria-hidden="true" data-words='{{ ic.words | dump | safe }}'>
  <i class="bp-crop tl"></i><i class="bp-crop tr"></i><i class="bp-crop bl"></i><i class="bp-crop br"></i>
  <div class="bp-stamp">
    <span><b>MELO CREATIVE</b></span><span>{{ ic.sheet }}</span>
    <span>{{ ic.scale }}</span><span class="bp-date"></span>
  </div>
  <button class="bp-skip" type="button" tabindex="-1">{{ ic.skip }}</button>
</div>
