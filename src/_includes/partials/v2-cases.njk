{%- set t = i18n[lang] -%}
{%- set c = v2[lang] -%}
{%- set P = t.prefix -%}
{%- set AR = '<svg class="ar" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M1 6h10M7 2l4 4-4 4"/></svg>' -%}
<section class="list-hero">
  <div class="wrap">
    <h1 class="h1 rv d1">{{ c.casesPage.title }}<span class="pt">.</span></h1>
    <p class="lead rv d2">{{ c.casesPage.lead }}</p>
  </div>
</section>
<section>
  <div class="wrap">
    <div class="filters rv" id="filters" role="group">
      {% for f in c.casesPage.filters %}
      <button data-f="{{ f[0] }}"{% if loop.first %} class="on"{% endif %}>{{ f[1] }}</button>
      {% endfor %}
    </div>
    <div class="cgrid">
      {% for cs in cases %}
      <a class="ccard rv" href="{{ P }}/{{ cs.slug }}" data-svc="{{ cs.dataService | join(' ') }}">
        <div class="pic"><img src="{{ cs.cardImage or cs.heroMedia.src }}" alt="{{ cs[lang].cardTitle }}"{% if loop.index > 3 %} loading="lazy"{% endif %}{% if cs.cardImagePosition %} style="object-position:{{ cs.cardImagePosition }}"{% endif %}></div>
        <div class="row"><h3>{{ cs[lang].heroTitleLine1 }}</h3></div>
        <p>{{ cs[lang].cardDesc }}</p>
        <span class="tags">{{ cs[lang].tags | join(' · ') }}{% if cs.year %} · {{ cs.year }}{% endif %}</span>
      </a>
      {% endfor %}
    </div>
    <p class="empty-state" id="emptyState" hidden>{{ c.casesPage.empty }}</p>
  </div>
</section>
<section class="cta-band">
  <div class="wrap">
    <h2 class="h2 rv">{{ c.casesPage.ctaTitle }}<span class="pt">.</span></h2>
    <div class="hero-ctas rv d1"><a class="btn btn-gray" href="{{ t.contactPath }}">{{ c.nav.cta }} {{ AR | safe }}</a></div>
  </div>
</section>
