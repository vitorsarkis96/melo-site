{%- set c = v2[lang] -%}
{%- set cs = c.contactSec -%}
<section class="contact" id="contato">
  <div class="wrap c-wrap">
    <div class="c-left">
      {% if contactAsH1 %}<h1 class="h2 rv d1"><span data-e="{{ lang }}|contactPage.title">{{ c.contactPage.title }}</span><span class="pt">.</span></h1>
      <p class="lead rv d2"><span data-e="{{ lang }}|contactPage.lead">{{ c.contactPage.lead }}</span></p>{% else %}<h2 class="h2 rv d1"><span data-e="{{ lang }}|contactSec.title">{{ cs.title }}</span><span class="pt">.</span></h2>
      <p class="lead rv d2"><span data-e="{{ lang }}|contactSec.lead">{{ cs.lead }}</span></p>{% endif %}
      <div class="c-info rv d3">
        {% for i in cs.info %}{% set ix = loop.index0 %}{% if i[2] %}<a href="{{ i[2] }}" data-item="{{ lang }}|contactSec.info.{{ ix }}"{% if 'http' in i[2] %} target="_blank" rel="noopener"{% endif %}><span class="mono" data-e="{{ lang }}|contactSec.info.{{ ix }}.label">{{ i[0] }}</span><span data-e="{{ lang }}|contactSec.info.{{ ix }}.value">{{ i[1] }}</span></a>{% else %}<div data-item="{{ lang }}|contactSec.info.{{ ix }}"><span class="mono" data-e="{{ lang }}|contactSec.info.{{ ix }}.label">{{ i[0] }}</span><span data-e="{{ lang }}|contactSec.info.{{ ix }}.value">{{ i[1] }}</span></div>{% endif %}{% endfor %}
      </div>
    </div>
    <div class="sheet rv d1">
      <form id="briefForm" action="https://formspree.io/f/{{ site.formspreeId }}" method="POST" novalidate>
        <input type="hidden" name="_subject" value="Novo contato pelo site">
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true">
        <div class="f-row">
          <div class="fld"><label for="fNome"><span data-e="{{ lang }}|contactSec.name">{{ cs.name }}</span></label><input id="fNome" name="nome" autocomplete="name" placeholder="{{ cs.namePh }}" required></div>
          <div class="fld"><label for="fCont"><span data-e="{{ lang }}|contactSec.contact">{{ cs.contact }}</span></label><input id="fCont" name="contato" autocomplete="email" inputmode="email" placeholder="{{ cs.contactPh }}" required></div>
        </div>
        <div class="fld"><label for="fMsg"><span data-e="{{ lang }}|contactSec.project">{{ cs.project }}</span></label><textarea id="fMsg" name="mensagem" rows="4" placeholder="{{ cs.projectPh }}"></textarea></div>
        <div class="f-foot">
          <span class="mono" id="fNote" role="status" aria-live="polite"><span data-e="{{ lang }}|contactSec.note">{{ cs.note }}</span></span>
          <button class="btn btn-gray" type="submit"><span data-e="{{ lang }}|contactSec.send">{{ cs.send }}</span> <svg class="ar" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.3"><path d="M1 6h10M7 2l4 4-4 4"/></svg></button>
        </div>
      </form>
    </div>
  </div>
</section>
