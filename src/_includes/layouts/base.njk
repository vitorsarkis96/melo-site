{%- set t = i18n[lang] -%}
{%- set currentPath = (t.prefix + "/" + (slug or "")) | replace("//", "/") -%}
{%- set altPathPrefix = "/en" if lang == "pt" else "/" -%}
{%- set altPath = (altPathPrefix + "/" + (slug or "")) | replace("//", "/") -%}
{%- set canonicalUrl = site.baseUrl + currentPath -%}
{%- set enUrl = site.baseUrl + (("/en/" + (slug or "")) | replace("//", "/")) -%}
{%- set ptUrl = site.baseUrl + (("/" + (slug or "")) | replace("//", "/")) -%}
<!DOCTYPE html>
<html lang="{{ t.htmlLang }}">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ metaTitle | safe }}</title>
<meta name="description" content="{{ metaDescription | safe }}" />
<link rel="canonical" href="{{ canonicalUrl }}" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/favicon-16x16.png" />
<link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png" />
<link rel="alternate" hreflang="en" href="{{ enUrl }}" />
<link rel="alternate" hreflang="pt-BR" href="{{ ptUrl }}" />
<link rel="alternate" hreflang="x-default" href="{{ ptUrl }}" />
<meta property="og:type" content="{{ ogType or 'website' }}" />
<meta property="og:site_name" content="Melo Creative" />
<meta property="og:locale" content="{{ t.ogLocale }}" />
<meta property="og:title" content="{{ metaTitle | safe }}" />
<meta property="og:description" content="{{ metaDescription | safe }}" />
<meta property="og:url" content="{{ canonicalUrl }}" />
<meta property="og:image" content="{{ site.baseUrl }}{{ ogImage | safe }}" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ metaTitle | safe }}" />
<meta name="twitter:description" content="{{ metaDescription | safe }}" />
<meta name="twitter:image" content="{{ site.baseUrl }}{{ ogImage | safe }}" />
{% if structuredData %}
<script type="application/ld+json">
{{ structuredData | dump | safe }}
</script>
{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
<noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet" /></noscript>
<link rel="stylesheet" href="/assets/css/style.css" />
<script defer src="/_vercel/insights/script.js"></script>
</head>
<body>

<header class="site-header" id="site-header">
  <a href="{{ '#top' if isHome else (t.prefix + '/') | replace('//','/') }}"><img class="logo-melo" src="/assets/icons/logo-melo.svg" alt="Melo" /></a>
  <nav class="nav-links">
    <a class="menu-link{{ ' is-active' if navActive == 'how' }}" href="{{ (t.prefix + '/#atuamos') | replace('//','/') }}">{{ t.navHowWeWork }}</a>
    <a class="menu-link{{ ' is-active' if navActive == 'cases' }}" href="{{ (t.prefix + '/cases') | replace('//','/') }}">{{ t.navCases }}</a>
    <a class="menu-link" href="{{ t.contactPath }}">{{ t.navContact }}</a>
    <a class="lang-switch" href="{{ altPath }}" aria-label="{{ t.langSwitchAria }}">
      <img src="{{ t.flagIcon }}" alt="" width="20" height="20" />
    </a>
  </nav>
  <button class="nav-toggle" id="nav-toggle" aria-label="{{ t.navOpenMenu }}" aria-expanded="false" aria-controls="mobile-menu">
    <span></span><span></span><span></span>
  </button>
</header>

<div class="mobile-menu" id="mobile-menu">
  <div class="mobile-menu__top">
    <img class="mobile-menu__logo" src="/assets/icons/melo-mark-small.svg" alt="Melo" />
    <button class="mobile-menu__close" id="mobile-menu-close" aria-label="{{ t.navCloseMenu }}">✕</button>
  </div>
  <nav class="mobile-menu__links">
    <a href="{{ (t.prefix + '/#atuamos') | replace('//','/') }}">{{ t.navHowWeWork }}</a>
    <a href="{{ (t.prefix + '/cases') | replace('//','/') }}"{{ ' class="is-active"' | safe if navActive == 'cases' }}>{{ t.navCases }}</a>
    <a href="{{ t.contactPath }}">{{ t.navContact }}</a>
    <a class="mobile-menu__lang" href="{{ altPath }}">
      <img src="{{ t.flagIcon }}" alt="" width="20" height="20" />
      {{ t.langSwitchLabel }}
    </a>
  </nav>
  <a class="btn btn-orange btn-lg mobile-menu__cta" href="{{ t.contactPath }}">
    {{ t.ctaQuote }}
    <img class="btn-icon" src="/assets/icons/arrow-right.svg" alt="" />
  </a>
</div>

<main id="top">

{{ content | safe }}

  <!-- FOOTER / FINAL CTA -->
  <div class="footer-wrap" id="contato">
    <footer class="footer-card reveal">
      <div class="footer-top">
        <div class="footer-headline">
          <p class="line1">{{ t.footerLine1 }}</p>
          <div class="line2-row">
            <p class="line2">{{ t.footerLine2 }}</p>
            {% if slug != "contato" %}
            <a class="btn btn-orange btn-lg" href="{{ t.contactPath }}">
              {{ t.ctaQuote }}
              <img class="btn-icon" src="/assets/icons/arrow-right.svg" alt="" />
            </a>
            {% endif %}
          </div>
        </div>
        <div class="footer-right">
          <div class="socials">
            <a href="{{ site.instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><img src="/assets/icons/social-instagram.svg" alt="Instagram" /></a>
            <a href="{{ site.linkedin }}" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><img src="/assets/icons/social-linkedin.svg" alt="LinkedIn" /></a>
          </div>
          <nav class="footer-nav">
            <a class="menu-link{{ ' is-active' if navActive == 'how' }}" href="{{ (t.prefix + '/#atuamos') | replace('//','/') }}">{{ t.footerWhatWeDo }}</a>
            <a class="menu-link{{ ' is-active' if navActive == 'cases' }}" href="{{ (t.prefix + '/cases') | replace('//','/') }}">{{ t.navCases }}</a>
            <a class="menu-link" href="{{ t.contactPath }}">{{ t.navContact }}</a>
          </nav>
        </div>
      </div>

      <div class="footer-divider"></div>

      <div class="footer-bottom">
        <a href="{{ (t.prefix + '/') | replace('//','/') }}"><img class="footer-logo" src="/assets/icons/melo-mark-small.svg" alt="Melo" /></a>
        <p class="footer-contact">
          {{ site.phone }}<br />
          {{ site.addressLine }}{{ ' - Brazil' if lang == 'en' }}<br />
          {{ site.email }}
        </p>
      </div>
    </footer>
  </div>

</main>

<div class="video-modal" id="video-modal" aria-hidden="true">
  <div class="video-modal__backdrop" data-video-modal-close></div>
  <div class="video-modal__dialog" role="dialog" aria-modal="true">
    <button type="button" class="video-modal__close" data-video-modal-close aria-label="{{ t.navCloseMenu }}">✕</button>
    <div class="video-modal__frame"></div>
  </div>
</div>

{% if site.newsletterPopup.enabled %}
{% set popup = site.newsletterPopup[lang] %}
<div class="newsletter-popup" id="newsletter-popup" aria-hidden="true" data-delay-seconds="{{ site.newsletterPopup.delaySeconds | default(6) }}">
  <div class="newsletter-popup__backdrop" data-newsletter-close></div>
  <div class="newsletter-popup__dialog" role="dialog" aria-modal="true" aria-labelledby="newsletter-popup-title">
    <button type="button" class="newsletter-popup__close" data-newsletter-close aria-label="{{ popup.dismissAria }}">✕</button>
    <img class="newsletter-popup__mark" src="/assets/icons/melo-mark-small.svg" alt="" />
    <h2 id="newsletter-popup-title">{{ popup.title }}</h2>
    <p>{{ popup.desc }}</p>
    <form class="newsletter-popup__form" data-newsletter-form data-success-message="{{ popup.successMessage }}" data-error-message="{{ popup.errorMessage }}">
      <input type="email" name="email" placeholder="{{ popup.placeholder }}" required />
      <button type="submit" class="btn btn-orange">{{ popup.submitLabel }}</button>
    </form>
    <p class="newsletter-popup__status" data-newsletter-status role="status" aria-live="polite"></p>
  </div>
</div>
{% endif %}

<script src="/assets/js/main.js" defer></script>
</body>
</html>
